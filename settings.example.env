# === Dynatrace ===
# Classic Environment API (Problems + Traces)
DYNATRACE_URL=https://your-environment.live.dynatrace.com
DYNATRACE_API_TOKEN=dt0c01.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Platform / OAuth (if you later switch to modern SDK)
# DYNATRACE_PLATFORM_TOKEN=...

# === OpenSearch (AWS) ===
OPENSEARCH_HOSTS=https://your-domain.us-east-1.es.amazonaws.com
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=true

OPENSEARCH_INDEX_TRACES=otel-v1-apm-span-*
OPENSEARCH_INDEX_LOGS=logs-*

# --- Auth Option 1: Client Certificate (mTLS) ---
# OPENSEARCH_CLIENT_CERT=/path/to/client.pem
# OPENSEARCH_CLIENT_KEY=/path/to/client-key.pem
# OPENSEARCH_CA_CERTS=/path/to/root-ca.pem

# --- Auth Option 2: AWS IAM SigV4 (recommended when MFA is enabled) ---
# These are the standard AWS environment variables.
# After MFA / SSO login you can export them, or rely on an instance/role profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=          # required when using temporary credentials (MFA / SSO)
AWS_REGION=us-east-1
# OPENSEARCH_AWS_REGION=us-east-1          # alternative name
# OPENSEARCH_AWS_SERVICE=es                # "es" for managed domains, "aoss" for Serverless
# OPENSEARCH_USE_IAM=true                  # force IAM even without explicit keys (role-based)

# --- Auth Option 3: Basic auth (only if your domain still allows it) ---
# OPENSEARCH_USER=admin
# OPENSEARCH_PASSWORD=admin

# === Agent behaviour ===
DEFAULT_LOOKBACK_HOURS=4
MAX_LOG_LINES=200
MAX_SEARCH_RESULTS=50
