# === Dynatrace ===
# Classic Environment API (Problems + Traces)
DYNATRACE_URL=https://your-environment.live.dynatrace.com
DYNATRACE_API_TOKEN=dt0c01.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Platform / OAuth (if you later switch to modern SDK)
# DYNATRACE_PLATFORM_TOKEN=...

# === OpenSearch ===
OPENSEARCH_HOSTS=https://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_TRACES=otel-v1-apm-span-*
OPENSEARCH_INDEX_LOGS=logs-*

# === Agent behaviour ===
DEFAULT_LOOKBACK_HOURS=4
MAX_LOG_LINES=200
MAX_SEARCH_RESULTS=50